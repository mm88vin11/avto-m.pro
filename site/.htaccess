# AVTO-M · Apache (рег.ру). Всё, кроме существующих файлов, идёт в index.php.
Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. HTTPS и адрес без www. Включайте после выпуска SSL-сертификата (см. docs/DEPLOY.md, шаг 4).
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://avto-m.pro%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 2. Служебное закрыто
  RewriteRule ^app(/|$) - [F,L]
  RewriteRule (^|/)\. - [F,L]
  RewriteRule \.(sqlite|sqlite-wal|sqlite-shm|log|md|ini|sh|bak|zip)$ - [F,L,NC]

  # 3. Существующие файлы отдаём напрямую, остальное — в index.php
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^(assets|uploads)/ - [L]
  RewriteCond %{REQUEST_URI} !^/favicon\.ico$
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
